# editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[{compose.yaml,compose.*.yaml}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

# The workflows are indented like those of the other image repositories (base-php is the
# reference); their shell scripts and the Makefile use tabs.
[.github/**]
indent_size = 2

[{.github/**.sh,Makefile}]
indent_style = tab
